# ---- Firebase (Auth) -----------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ---- Client API ----------------------------------------------------------
# Leave EMPTY to use the built-in mock backend (src/data/*). Set to the Express
# server base URL (e.g. https://api.fundspring.io) to use real data instead.
NEXT_PUBLIC_API_URL=

# ---- imgBB (client-side image upload) ------------------------------------
# https://api.imgbb.com/ -> get a free API key
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# ---- Payments (Purchase Credit) ------------------------------------------
# Switch provider: stripe | bkash  (keep both in sync)
PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# bKash Tokenized Checkout (sandbox defaults shown)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
# Optional — defaults to http(s)://<host>/api/bkash/callback
BKASH_CALLBACK_URL=
# USD → BDT conversion for package prices (UI + charge)
BKASH_BDT_PER_USD=110
NEXT_PUBLIC_BKASH_BDT_PER_USD=110
